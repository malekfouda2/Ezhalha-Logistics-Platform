# Point the app at a staging API. NEVER production — creating a shipment there books a
# real carrier consignment and charges a real card.
# Staging API. sslip.io resolves the IP embedded in the hostname back to the server, so this is
# a real HTTPS endpoint with a valid certificate and no DNS record to maintain. It will be
# replaced by https://staging.ezhalha.co once that A record exists; both already work.
EXPO_PUBLIC_API_BASE_URL=https://staging.147-93-122-137.sslip.io

# Tap test (sandbox) publishable key. Test keys only in this file.
EXPO_PUBLIC_TAP_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx
